		annotation SummarizationSetBy = User

	column 'Insurer Name'
		dataType: string
		lineageTag: cebe6c6c-bdbd-4b79-aab7-20fe2842c0aa
		summarizeBy: none
		sourceColumn: issuer_name

		annotation SummarizationSetBy = User

	column Insurer
		dataType: string
		lineageTag: 977498e9-1d18-459f-957b-f98cd44265a8
		summarizeBy: none
		sourceColumn: insurer

		annotation SummarizationSetBy = User

	column 'Plan Name'
		dataType: string
		lineageTag: 15eb7ebf-81ee-4c22-89c8-81197afc1d94
		summarizeBy: none
		sourceColumn: plan_name

		annotation SummarizationSetBy = User

	column 'Metal Level'
		dataType: string
		lineageTag: 024a6230-9505-46f4-b0f9-eb3580c2d541
		summarizeBy: none
		sourceColumn: metal_level
		sortByColumn: 'Metal Level Order'

		annotation SummarizationSetBy = User

	column 'Metal Level Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4791d59c-bfc1-4292-bff0-acfc143abef0
		summarizeBy: none
		sourceColumn: metal_level_order

		annotation SummarizationSetBy = User

	column 'Metal Level (CMS Label)'
		dataType: string
		lineageTag: de128772-1944-4c23-81b8-148d92ff04b1
		summarizeBy: none
		sourceColumn: metal_level_raw

		annotation SummarizationSetBy = User

	column 'Plan Type'
		dataType: string
		lineageTag: dd637737-4f5a-4c73-83d4-b5867b8e4770
		summarizeBy: none
		sourceColumn: plan_type

		annotation SummarizationSetBy = User

	column 'Predecessor Plans'
		dataType: int64
		formatString: 0
		lineageTag: acea21be-b3a1-41be-bb04-85d5d9c083c7
		summarizeBy: none
		sourceColumn: predecessor_count

		annotation SummarizationSetBy = User

	column 'Predecessor Plan IDs'
		dataType: string
		lineageTag: c98a5d26-79b7-4bc2-b88c-8e509322b3b2
		summarizeBy: none
		sourceColumn: predecessor_plan_ids

		annotation SummarizationSetBy = User

	column 'Rating Areas'
		dataType: int64
		formatString: 0
		lineageTag: 2dbe1b3c-736f-48dc-8a6d-843a8b976bb6
		summarizeBy: none
		sourceColumn: rating_area_count

		annotation SummarizationSetBy = User

	column 'Premium 2026'
		dataType: double
		formatString: \$#,0.00
		lineageTag: e83346d6-a3c9-4ce0-8ec2-d4bcbe1d5e70
		summarizeBy: none
		sourceColumn: avg_rate_2026

		annotation SummarizationSetBy = User

	column 'Premium 2027'
		dataType: double
		formatString: \$#,0.00
		lineageTag: c37a0b4e-4261-4845-be69-073840c7175f
		summarizeBy: none
		sourceColumn: avg_rate_2027

		annotation SummarizationSetBy = User

	column 'Change ($)'
		dataType: double
		formatString: +\$#,0.00;-\$#,0.00;\$0.00
		lineageTag: addf09fb-4f02-4eea-86a5-77b71cd9be5d
		summarizeBy: none
		sourceColumn: avg_change_dollars

		annotation SummarizationSetBy = User

	column 'Change (%)'
		dataType: double
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 376b7b35-f6b2-4185-a284-39d235781c54
		summarizeBy: none
		sourceColumn: avg_change_pct

		annotation SummarizationSetBy = User

	column 'Change Band'
		dataType: string
		lineageTag: 9ec57272-c700-4dca-9f3c-1494eb0cfa86
		summarizeBy: none
		sourceColumn: change_band
		sortByColumn: 'Change Band Start'

		annotation SummarizationSetBy = User

	column 'Change Band Start'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5a68d8dc-9db3-4a93-a29f-cb1e2fbd1806
		summarizeBy: none
		sourceColumn: change_band_start

		annotation SummarizationSetBy = User

	partition 'Plan Changes' = m
		mode: import
		source =
				let
				    // Final table from the dbt project: one row per 2027 plan (see the repo README)
				    Source = Parquet.Document(Binary.Buffer(Web.Contents("https://raw.githubusercontent.com/anz-builds/aca-premium-increases/default/data/clean/plan_premium_changes.parquet"))),
				    Typed = Table.TransformColumnTypes(Source, {
				        {"plan_id_2027", type text}, {"state", type text}, {"issuer_id", type text},
				        {"issuer_name", type text}, {"plan_name", type text}, {"metal_level", type text},
				        {"metal_level_raw", type text}, {"plan_type", type text},
				        {"predecessor_count", Int64.Type}, {"predecessor_plan_ids", type text},
				        {"rating_area_count", Int64.Type}, {"avg_rate_2026", type number},
				        {"avg_rate_2027", type number}, {"avg_change_dollars", type number},
				        {"avg_change_pct", type number}}),
				    // Insurers are grouped by name within each state (three Texas insurers file
				    // under two CMS insurer IDs each)
				    AddInsurer = Table.AddColumn(Typed, "insurer", each [state] & ": " & [issuer_name], type text),
				    // Bronze, Silver, Gold sort order for charts
				    AddMetalOrder = Table.AddColumn(AddInsurer, "metal_level_order",
				        each if [metal_level] = "Bronze" then 1 else if [metal_level] = "Silver" then 2 else 3,
				        Int64.Type),
				    // 5-point bands of plan-level change for the spread chart
				    AddBandStart = Table.AddColumn(AddMetalOrder, "change_band_start",
				        each Number.RoundDown(Number.Round([avg_change_pct] * 100, 6) / 5) * 5, Int64.Type),
				    Signed = (n as number) as text => (if n > 0 then "+" else "") & Text.From(n) & "%",
				    AddBand = Table.AddColumn(AddBandStart, "change_band",
				        each Signed([change_band_start]) & " to " & Signed([change_band_start] + 5), type text)
				in
				    AddBand

