table 'Plan Changes'
	lineageTag: 1a9fc2a2-1135-4008-905e-9b58a97cb5c8

	/// Number of 2027 plans compared.
	measure Plans = COUNTROWS('Plan Changes')
		formatString: #,0
		lineageTag: 67e97805-caf4-45d3-8f7d-f1cd1c6085a6

	/// Median plan-level change in the age-40 premium. Each plan counts once.
	measure 'Median Change' = MEDIAN('Plan Changes'[Change (%)])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: eefffaa0-029e-4354-884d-2aac13692bc1

	/// Unweighted mean plan-level change in the age-40 premium.
	measure 'Average Change' = AVERAGE('Plan Changes'[Change (%)])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 97925606-425f-440a-bb3c-f3111cf46731

	/// A quarter of plans changed by less than this.
	measure 'Change 25th Percentile' = PERCENTILE.INC('Plan Changes'[Change (%)], 0.25)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 9ee12cdc-7ca1-435b-93ea-be58184da1b7

	/// Three quarters of plans changed by less than this.
	measure 'Change 75th Percentile' = PERCENTILE.INC('Plan Changes'[Change (%)], 0.75)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 630d14c2-8ae9-496e-a440-7fcbe3dcb04d

	/// Unweighted mean age-40 monthly premium in 2026.
	measure 'Average Premium 2026' = AVERAGE('Plan Changes'[Premium 2026])
		formatString: \$#,0
		lineageTag: c7df1737-b679-437f-a6fa-93033daa6870

	/// Unweighted mean age-40 monthly premium in 2027.
	measure 'Average Premium 2027' = AVERAGE('Plan Changes'[Premium 2027])
		formatString: \$#,0
		lineageTag: 85bd7490-ca99-4263-a66c-5ca975031428

	/// Unweighted mean change in the age-40 monthly premium, in dollars.
	measure 'Average Change ($)' = AVERAGE('Plan Changes'[Change ($)])
		formatString: +\$#,0;-\$#,0;\$0
		lineageTag: 65d8c242-6a6e-4681-abae-4b28deb59986

	/// Plans whose age-40 premium went down.
	measure 'Plans With a Price Cut' = CALCULATE([Plans], 'Plan Changes'[Change (%)] < 0) + 0
		formatString: #,0
		lineageTag: f703d426-1740-49ca-9fe2-22da255ce919

	/// Share of plans whose age-40 premium went down.
	measure 'Share With a Price Cut' = DIVIDE([Plans With a Price Cut], [Plans])
		formatString: 0.0%
		lineageTag: 1f09dd90-2cbf-44d5-ab6a-8172083fedab

	/// States with plans compared.
	measure States = DISTINCTCOUNT('Plan Changes'[State])
		formatString: #,0
		lineageTag: f834fbe0-5c4e-4ba9-b299-08e1eec3c05f

	/// Insurers, counted separately in each state.
	measure Insurers = DISTINCTCOUNT('Plan Changes'[Insurer])
		formatString: #,0
		lineageTag: 6c3bb5b4-a635-4a9e-ab98-889973d8f97e

	/// Card subtitle showing the middle half of plan changes.
	measure 'Median Change Subtitle' = "Middle half of plans: " & FORMAT([Change 25th Percentile], "+0.0%") & " to " & FORMAT([Change 75th Percentile], "+0.0%")
		lineageTag: 3b415d56-3b44-49ae-9d16-dc21e624be73

	/// Card subtitle comparing the 2027 premium to 2026.
	measure 'Premium Subtitle' = "Up from " & FORMAT([Average Premium 2026], "$#,0") & " in 2026 (" & FORMAT([Average Change ($)], "+$#,0;-$#,0") & " a month)"
		lineageTag: a175782a-9ff2-4c6f-a9d1-b775c4ecb3b2

	/// Card subtitle with the number of states and insurers.
	measure 'Plans Subtitle' = "Across " & [States] & " states and " & [Insurers] & " insurers"
		lineageTag: 7b12356e-b3af-42fa-ad60-a2ef23ce3144

	/// Card subtitle with the share of plans that got cheaper.
	measure 'Price Cut Subtitle' = FORMAT([Share With a Price Cut], "0.0%") & " of plans compared"
		lineageTag: fba76774-4828-4317-a536-bc156e159234

	column 'Plan ID'
		dataType: string
		lineageTag: 65fbbef4-0532-4da0-8453-5342d510735d
		summarizeBy: none
		sourceColumn: plan_id_2027

		annotation SummarizationSetBy = User

	column State
		dataType: string
		lineageTag: 6a92883a-6b3d-4b8a-acb5-dac956700c03
		summarizeBy: none
